              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to return"
              },
              {
                "name": "filter[]",
                "value": "",
                "type": "query",
                "description": "Filter to use"
              }
            ]
          },
          "docs": "This endpoint returns a list of videos by page."
        }
      ]
    }
  ],
  "bundled": true
